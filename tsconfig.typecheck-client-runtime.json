{
  "extends": "./tsconfig.typecheck.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "tsBuildInfoFile": ".tmp/tsbuildinfo/typecheck-client-runtime.tsbuildinfo"
  },
  "include": [
    "client/js-esm/**/*.ts",
    "tools/maps/processmap.ts",
    "shared/js/maps/*.ts",
    "shared/js/connection-status.ts",
    "shared/js/entity-kind-domain.ts",
    "shared/js/protocol-schema.ts",
    "shared/js/protocol-contract-types.ts",
    "shared/js/typed-event-emitter.ts",
    "shared/js/evented.ts",
    "shared/js/gametypes.ts",
    "shared/js/gametypes-browser.ts"
  ]
}
