{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "composite": true,
    "strict": false,
    "tsBuildInfoFile": ".tmp/tsbuildinfo/typecheck-tools.tsbuildinfo"
  },
  "include": [
    "tools/**/*.ts",
    "server/ecs/**/*.ts",
    "server/world/claims/**/*.ts",
    "server/world/chunks/chunk-overlay-store.ts",
    "client/client-boundary-types.ts",
    "client/gameclient-outbound-actions.ts",
    "client/world/chunks/client-chunk-overlay-cache.ts",
    "shared/**/*.ts"
  ],
  "exclude": ["node_modules/**", "dist/**"]
}
