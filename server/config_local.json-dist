{
    "port": 8000,
    "debug_level": "debug",
    "nb_players_per_world": 2000,
    "nb_worlds": 1,
    "updates_per_second": 30,
    "map_filepath": "./assets/maps/tiled/world.json",
    "metrics_enabled": false,
    "chunk_size": 32,
    "chunk_overlay_db_path": "./server/.data/chunk-overlays.{worldId}.sqlite",
    "claims_db_path": "./server/.data/claims.{worldId}.sqlite",
    "chunk_overlay_flush_interval_ms": 10000,
    "chunk_overlay_flush_max_chunks": 64,
    "chunk_overlay_bootstrap_load_limit_chunks": 4096,
    "chunk_snapshot_payload_max_utf8_bytes": 65536,
    "chunk_snapshot_max_parts": 128,
    "memcached_host": "127.0.0.1",
    "memcached_port": 11211,
    "server_name": "local",
    "game_servers": [
        { "name": "local" }
    ]
}
