{
  "extends": "./tsconfig.typecheck.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "tsBuildInfoFile": ".tmp/tsbuildinfo/typecheck-server-esm.tsbuildinfo",
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": [
    "server/js/main-runtime-types.ts",
    "server/js/main-runtime.ts",
    "server/js/config-preflight.ts",
    "server/js/metrics-runtime.ts",
    "server/js/metrics.ts",
    "server/js/metrics-client.ts",
    "server/js/formulas.ts",
    "server/js/checkpoint.ts",
    "server/js/npc.ts",
    "server/js/format.ts",
    "server/js/message.ts",
    "server/js/entity.ts",
    "server/js/character.ts",
    "server/js/item.ts",
    "server/js/mob.ts",
    "server/js/properties.ts",
    "server/js/area.ts",
    "server/js/chest.ts",
    "server/js/chestarea.ts",
    "server/js/map.ts",
    "server/js/player.ts",
    "server/js/mobarea.ts",
    "server/js/worldserver.ts",
    "server/js/metrics-adapters/*.ts",
    "server/js/server-event-names.ts",
    "server/js/*-esm.ts",
    "server/js/main-esm*.ts",
    "server/js/ws-runtime-class-factory.ts",
    "server/js/**/*.cts",
    "shared/js/connection-status.ts",
    "shared/js/entity-kind-domain.ts",
    "shared/js/protocol-contract.ts",
    "shared/js/protocol-contract-types.ts",
    "shared/js/gametypes-browser.ts",
    "shared/js/*-esm.ts",
    "shared/js/**/*.cts",
    "tools/maps/processmap.ts"
  ]
}
