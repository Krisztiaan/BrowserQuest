{
  "extends": "./tsconfig.typecheck.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "tsBuildInfoFile": ".tmp/tsbuildinfo/typecheck-server-esm.tsbuildinfo",
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": [
    "server/js/main-runtime-types.ts",
    "server/js/main-runtime.cts",
    "server/js/server-event-names.ts",
    "server/js/*-esm.ts",
    "server/js/main-esm*.ts",
    "server/js/ws-runtime-class-factory.ts",
    "shared/js/connection-status.ts",
    "shared/js/entity-kind-domain.ts",
    "shared/js/protocol-contract-types.ts",
    "shared/js/gametypes-browser.ts",
    "shared/js/*-esm.ts"
  ]
}
