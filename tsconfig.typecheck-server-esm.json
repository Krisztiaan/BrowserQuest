    "server/js/worldserver-hurt-entity.ts",
    "server/js/worldserver-mob-orchestration.ts",
    "server/js/worldserver-contracts.ts",
    "server/js/worldserver-static-spawn.ts",
    "server/js/metrics-adapters/*.ts",
    "server/js/server-event-names.ts",
    "server/js/*-esm.ts",
    "server/js/main-esm*.ts",
    "server/js/ws-runtime-class-factory-types.ts",
    "server/js/ws-runtime-class-factory.ts",
    "shared/js/connection-status.ts",
    "shared/js/entity-kind-domain.ts",
    "shared/js/protocol-schema.ts",
    "shared/js/protocol-contract.ts",
