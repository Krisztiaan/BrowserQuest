{
  "name": "browserquest",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun run dev:bun:full",
    "dev:bun:build-client": "bun tools/dev/build-client-for-bun.ts",
    "dev:bun:build-playwright-config": "bun tools/dev/build-playwright-server-config.ts",
    "dev:bun:full": "bun run dev:bun:build-client && BQ_STATIC_ROOT=.tmp/dev-client bun --watch server/entry.ts",
    "dev:server": "bun run start:server",
    "start:server": "bun server/entry.ts",
    "content:prefabs:generate": "bun tools/content/prefabs.ts generate",
    "check:content:prefabs": "bun tools/content/prefabs.ts check",
    "build:maps": "bun tools/content/map-pack.ts generate",
    "check:maps": "bun tools/content/map-pack.ts check",
    "check:world-map:legacy": "bun tools/content/world-map-validator.ts --profile legacy",
    "check:world-map:target": "bun tools/content/world-map-validator.ts --profile target",
    "check:tileset-wang:audit": "bun tools/content/tileset-wang-audit.ts",
    "check:tileset-wang:audit:json": "bun tools/content/tileset-wang-audit.ts --json",
    "check:world-render-clusters": "bun tools/content/world-render-cluster-audit.ts",
    "check:world-render-clusters:json": "bun tools/content/world-render-cluster-audit.ts --json",
    "check:world-tile-paints": "bun tools/content/world-tile-paint-audit.ts",
    "check:world-tile-paints:json": "bun tools/content/world-tile-paint-audit.ts --json",
    "check:world-typed-objects": "bun tools/content/world-typed-object-audit.ts",
    "check:world-typed-objects:json": "bun tools/content/world-typed-object-audit.ts --json",
    "check:terrain-authoring": "bun tools/content/terrain-authoring-audit.ts",
    "build:terrain-visuals": "bun tools/content/terrain-visual-artifacts.ts",
    "audit:terrain-grammar": "bun tools/content/terrain-grammar-validator.ts",
    "legacy:fix:tileset-wang:scaffold": "bun tools/content/legacy/tileset-wang-scaffold.ts --write",
    "legacy:check:tileset-modernize:dry": "bun tools/content/legacy/tileset-modernize-metadata.ts",
    "legacy:fix:tileset-modernize": "bun tools/content/legacy/tileset-modernize-metadata.ts --write",
    "legacy:check:foreground-layers:dry": "bun tools/content/legacy/maps-migrate-v-to-foreground.ts",
    "legacy:fix:foreground-layers": "bun tools/content/legacy/maps-migrate-v-to-foreground.ts --strip-v --write",
    "legacy:check:world-standardize:dry": "bun tools/content/legacy/world-standardize-pipeline.ts --drop-plateau-mask --drop-blocking-mask --skip-validate",
    "legacy:fix:world-standardize": "bun tools/content/legacy/world-standardize-pipeline.ts --write --drop-plateau-mask --drop-blocking-mask",
    "legacy:fix:world-portals": "bun tools/content/legacy/world-curate-portals.ts --write",
    "build:client": "bun tools/build/client.ts",
    "build:server": "bun tools/build/server.ts",
    "build:bundle": "bun run build:client && bun run build:server && bun tools/build/bundle.ts",
    "typecheck": "bun x tsc -b tsconfig.json",
    "typecheck:client": "bun x tsc -p tsconfig.browser.json",
    "typecheck:server": "bun x tsc -p tsconfig.node.json",
    "typecheck:full:server": "bun x tsc -p tsconfig.full.server.json",
    "typecheck:full:client": "bun x tsc -p tsconfig.full.client.json",
    "typecheck:full": "bun run typecheck:full:server && bun run typecheck:full:client",
    "typecheck:tools": "bun x tsc -p tsconfig.tools.json",
    "check:metrics:healthy-prereqs": "bun tools/metrics/check-healthy-prereqs.ts",
    "test:modern-parity": "bun test tests/smoke/modern-gameplay-parity.test.ts --timeout 30000",
    "test:server:probes": "bun test tests/smoke/server-health-version.test.ts --timeout 30000",
    "test:server:shutdown": "bun test tests/smoke/server-shutdown-signals.test.ts --timeout 30000",
    "test:metrics:healthy": "bun run check:metrics:healthy-prereqs && BQ_TEST_METRICS_HEALTH=1 bun test --timeout 30000 tests/smoke/server-metrics-healthy.optional.test.ts",
    "test:ws:runtime:parity": "bun test tests/unit/ws/runtime-parity.test.ts tests/unit/ws/runtime-factory.test.ts tests/unit/ws/server-runtime.test.ts",
    "test:ws:runtime:decision": "bun test tests/unit/ws/runtime-boundary-decision.test.ts tests/unit/ws/runtime-parity.test.ts",
    "test:browser:modern": "playwright test --config=playwright.config.ts",
    "test:browser:protocol-invariant": "playwright test --config=playwright.config.ts tests/browser/protocol-invariant.playwright.ts",
    "test:browser:protocol": "playwright test --config=playwright.config.ts tests/browser/modern-protocol-actions.playwright.ts tests/browser/protocol-invariant.playwright.ts",
    "test:browser:protocol:ci": "PLAYWRIGHT_JUNIT_OUTPUT_NAME=protocol-invariant-junit.xml playwright test --config=playwright.config.ts tests/browser/modern-protocol-actions.playwright.ts tests/browser/protocol-invariant.playwright.ts --reporter=line,junit",
    "bench:ecs": "bun tools/bench/ecs.ts",
    "bots:soak": "bun tools/bots/soak.ts",
    "admin:claims": "bun tools/admin/claims.ts",
    "audit:project-surface": "bun tools/maintenance/project-surface-inventory.ts",
    "check:clean-base-state": "bun tools/maintenance/check-clean-base-state.ts",
    "verify": "bun run verify:modern",
    "verify:modern": "bun run check:content:prefabs && bun run check:maps && bun run typecheck && bun run lint && bun run format:check && bun run test && bun run build:client && bun run build:server",
    "test": "bun test --timeout 20000",
    "lint": "bun run lint:modern",
    "lint:modern": "eslint --max-warnings=0 \"client/**/*.{ts,js}\" \"server/**/*.{ts,js}\" \"shared/**/*.{ts,js}\" \"tools/**/*.ts\" \"tests/**/*.ts\"",
    "lint:authority": "eslint --max-warnings=0 \"client/runtime/connection.ts\" \"client/game.ts\" \"client/gameclient.ts\" \"client/app.ts\" \"client/map.ts\" \"client/map-source.ts\" \"client/pathfinder.ts\" \"client/game-startup-wait.ts\" \"client/auth.ts\" \"server/runtime.ts\" \"server/player-session.ts\" \"server/player-session-command-translation.ts\" \"server/map.ts\" \"server/auth-session.ts\" \"server/passkey-auth.ts\" \"server/profile-preview.ts\" \"server/world/player-lifecycle.ts\" \"server/world/ecs-command-pipeline.ts\" \"server/ws/runtime.ts\" \"server/ws/runtime-factory.ts\" \"server/ws/connection-id.ts\" \"shared/protocol/**/*.ts\" \"shared/connection-status.ts\" \"shared/maps/processmap.ts\" \"shared/auth/cookie-keys.ts\"",
    "lint:client-runtime": "eslint --max-warnings=0 \"client/runtime/connection.ts\" \"client/game.ts\" \"client/gameclient.ts\"",
    "format": "prettier --write \"server/{log.ts,utils.ts,format.ts}\" \"client/platform/*.ts\" \"client/preflight.ts\" \"shared/gametypes-browser.ts\"",
    "format:check": "prettier --check \"server/{log.ts,utils.ts,format.ts}\" \"client/platform/*.ts\" \"client/preflight.ts\" \"shared/gametypes-browser.ts\""
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.2.2",
    "fflate": "^0.8.2",
    "memcache": "^1.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@types/node": "25.2.2",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "ajv": "6.14.0",
    "bun-types": "^1.3.14",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.4",
    "typescript": "5.9.3"
  },
  "overrides": {
    "brace-expansion": "1.1.15",
    "flatted": "3.4.2",
    "minimatch": "3.1.5",
    "picomatch": "4.0.4"
  }
}
