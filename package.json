{
  "name": "browserquest",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun run tools/dev.ts",
    "dev:client": "bun run tools/static-server.ts",
    "dev:server": "bun server/js/main.js",
    "dev:server:esm": "bun server/js/main-esm.mjs",
    "dev:vite": "vite",
    "dev:vite:full": "bun run tools/dev-vite.ts",
    "start:server": "bun server/js/main.js",
    "start:server:esm": "bun server/js/main-esm.mjs",
    "start:server:esm:ws-bridge:probe": "BQ_ESM_WS_BRIDGE_PROBE=1 bun server/js/main-esm.mjs",
    "start:server:esm:ws-runtime": "BQ_ESM_WS_RUNTIME=1 bun server/js/main-esm.mjs",
    "start:server:esm:ws-runtime:fail": "BQ_ESM_WS_RUNTIME=1 BQ_ESM_WS_RUNTIME_FORCE_FAIL=1 bun server/js/main-esm.mjs",
    "build:client": "node tools/legacy-retired.cjs build:client",
    "build:vite": "vite build",
    "build:vite:legacy": "node tools/legacy-retired.cjs build:vite:legacy",
    "build:ws-runtime-factory": "node tools/sync-ws-runtime-factory.cjs",
    "build:worldserver": "node tools/sync-worldserver.cjs",
    "build:player": "node tools/sync-player.cjs",
    "build:character": "node tools/sync-character.cjs",
    "build:mob": "node tools/sync-mob.cjs",
    "build:mobarea": "node tools/sync-mobarea.cjs",
    "build:map": "node tools/sync-map.cjs",
    "build:chest": "node tools/sync-chest.cjs",
    "build:properties": "node tools/sync-properties.cjs",
    "build:entity": "node tools/sync-entity.cjs",
    "build:item": "node tools/sync-item.cjs",
    "build:npc": "node tools/sync-npc.cjs",
    "build:message": "node tools/sync-message.cjs",
    "build:chestarea": "node tools/sync-chestarea.cjs",
    "build:checkpoint": "node tools/sync-checkpoint.cjs",
    "build:area": "node tools/sync-area.cjs",
    "build:formulas": "node tools/sync-formulas.cjs",
    "build:log": "node tools/sync-log.cjs",
    "build:utils": "node tools/sync-utils.cjs",
    "build:format": "node tools/sync-format.cjs",
    "build:metrics-client": "node tools/sync-metrics-client.cjs",
    "build:config-preflight": "node tools/sync-config-preflight.cjs",
    "build:main": "node tools/sync-main.cjs",
    "build:main-runtime": "node tools/sync-main-runtime.cjs",
    "build:ws-module": "node tools/sync-ws-module.cjs",
    "build:metrics": "node tools/sync-metrics.cjs",
    "build:metrics-runtime": "node tools/sync-metrics-runtime.cjs",
    "build:protocol-contract": "node tools/sync-protocol-contract.cjs",
    "check:runtime": "node tools/check-runtime.cjs",
    "check:server-shadow-hardening": "node tools/check-server-shadow-source-hardening.cjs",
    "check:cts-require-const": "node tools/check-cts-require-const.cjs",
    "check:deps:drift": "node tools/check-dependency-drift.cjs",
    "check:deps:drift:node22": "bash tools/node22-run.sh bun run check:deps:drift",
    "typecheck": "bun x tsc -p tsconfig.typecheck.json && bun x tsc -p tsconfig.typecheck-runtime.json && bun x tsc -p tsconfig.typecheck-server-esm.json && bun x tsc -p tsconfig.typecheck-client.json && bun x tsc -p tsconfig.typecheck-client-runtime.json",
    "typecheck:client": "bun x tsc -p tsconfig.typecheck-client.json",
    "typecheck:client-runtime": "bun x tsc -p tsconfig.typecheck-client-runtime.json",
    "typecheck:server-esm": "bun x tsc -p tsconfig.typecheck-server-esm.json",
    "typecheck:node22": "bash tools/node22-run.sh bun run typecheck",
    "check:class-fanout": "node tools/check-classjs-fanout.cjs",
    "check:client-runtime-alias-drift": "node tools/check-client-runtime-alias-drift.cjs",
    "check:client-runtime-alias-drift:strict": "node tools/check-client-runtime-alias-drift.cjs --strict",
    "check:client-runtime-coverage": "node tools/check-client-runtime-coverage.cjs",
    "check:server-esm-runtime-coverage": "node tools/check-server-esm-runtime-coverage.cjs",
    "check:ws-runtime-factory-sync": "node tools/sync-ws-runtime-factory.cjs --check",
    "check:worldserver-sync": "node tools/sync-worldserver.cjs --check",
    "check:player-sync": "node tools/sync-player.cjs --check",
    "check:character-sync": "node tools/sync-character.cjs --check",
    "check:mob-sync": "node tools/sync-mob.cjs --check",
    "check:mobarea-sync": "node tools/sync-mobarea.cjs --check",
    "check:map-sync": "node tools/sync-map.cjs --check",
    "check:chest-sync": "node tools/sync-chest.cjs --check",
    "check:properties-sync": "node tools/sync-properties.cjs --check",
    "check:entity-sync": "node tools/sync-entity.cjs --check",
    "check:item-sync": "node tools/sync-item.cjs --check",
    "check:npc-sync": "node tools/sync-npc.cjs --check",
    "check:message-sync": "node tools/sync-message.cjs --check",
    "check:chestarea-sync": "node tools/sync-chestarea.cjs --check",
    "check:checkpoint-sync": "node tools/sync-checkpoint.cjs --check",
    "check:area-sync": "node tools/sync-area.cjs --check",
    "check:formulas-sync": "node tools/sync-formulas.cjs --check",
    "check:log-sync": "node tools/sync-log.cjs --check",
    "check:utils-sync": "node tools/sync-utils.cjs --check",
    "check:format-sync": "node tools/sync-format.cjs --check",
    "check:metrics-client-sync": "node tools/sync-metrics-client.cjs --check",
    "check:config-preflight-sync": "node tools/sync-config-preflight.cjs --check",
    "check:main-sync": "node tools/sync-main.cjs --check",
    "check:main-runtime-sync": "node tools/sync-main-runtime.cjs --check",
    "check:ws-module-sync": "node tools/sync-ws-module.cjs --check",
    "check:metrics-sync": "node tools/sync-metrics.cjs --check",
    "check:metrics-runtime-sync": "node tools/sync-metrics-runtime.cjs --check",
    "check:protocol-contract-sync": "node tools/sync-protocol-contract.cjs --check",
    "check:protocol-contract-esm-parity": "bun tools/check-protocol-contract-esm-parity.cjs",
    "check:ws:runbooks": "node tools/check-ws-boundary-runbook-consistency.cjs",
    "check:legacy-signoff:ready": "node tools/check-legacy-signoff-readiness.cjs",
    "check:legacy-signoff:report": "node tools/check-legacy-signoff-readiness.cjs --allow-blocked",
    "check:legacy-signoff:report:json": "node tools/check-legacy-signoff-readiness.cjs --allow-blocked --json",
    "check:package-mode-boundaries": "node tools/check-package-mode-boundaries.cjs",
    "check:legacy-optimizer-integrity": "node tools/check-legacy-optimizer-integrity.cjs",
    "check:modern-jquery-free": "node tools/check-modern-jquery-free.cjs",
    "check:runtime-esm-require-free": "node tools/check-runtime-esm-require-free.cjs",
    "check:metrics:healthy-prereqs": "node tools/check-metrics-healthy-prereqs.cjs",
    "check:runtime:node22": "bash tools/node22-run.sh bun run check:runtime",
    "test:modern-parity": "bun test tests/smoke/modern-gameplay-parity.test.ts --timeout 30000",
    "test:static-entry": "bun test --timeout 20000 tests/smoke/static-server-entry-default.test.ts",
    "test:metrics:healthy": "bun run check:metrics:healthy-prereqs && BQ_TEST_METRICS_HEALTH=1 bun test --timeout 30000 tests/smoke/server-metrics-healthy.optional.test.ts",
    "test:smoke:esm:ws-runtime": "bun test --timeout 20000 tests/smoke/server-handshake-esm-ws-runtime.test.ts",
    "test:ws:runtime:parity": "bun test tests/unit/ws-runtime-parity.test.ts tests/unit/ws-runtime-class-factory.test.ts tests/unit/server-ws-esm.test.ts",
    "test:ws:runtime:decision": "bun test tests/unit/ws-runtime-boundary-decision.test.ts tests/unit/ws-runtime-parity.test.ts",
    "test:ws:runtime:drill": "node tools/run-ws-boundary-drill.cjs",
    "test:logs:lifecycle": "bun test --timeout 20000 tests/smoke/server-structured-logs.lifecycle.test.ts",
    "test:logs:fatal": "bun test --timeout 20000 tests/smoke/server-structured-logs.fatal.test.ts",
    "test:browser:modern": "bun run test:modern-browser",
    "test:browser:legacy": "node tools/legacy-retired.cjs test:browser:legacy",
    "test:browser:legacy:hook-probe": "node tools/legacy-retired.cjs test:browser:legacy:hook-probe",
    "test:browser:protocol-invariant": "bun run check:runtime && playwright test --config=playwright.config.ts tests/browser/protocol-invariant.playwright.ts",
    "test:browser:protocol": "bun run check:runtime && playwright test --config=playwright.config.ts tests/browser/modern-protocol-actions.playwright.ts tests/browser/protocol-invariant.playwright.ts",
    "test:browser:protocol:ci": "bun run check:runtime && PLAYWRIGHT_JUNIT_OUTPUT_NAME=protocol-invariant-junit.xml playwright test --config=playwright.config.ts tests/browser/modern-protocol-actions.playwright.ts tests/browser/protocol-invariant.playwright.ts --reporter=line,junit",
    "test:browser:modern:node22": "bun run test:modern-browser:node22",
    "test:browser:legacy:node22": "node tools/legacy-retired.cjs test:browser:legacy:node22",
    "test:browser:legacy:hook-probe:node22": "node tools/legacy-retired.cjs test:browser:legacy:hook-probe:node22",
    "test:browser:protocol-invariant:node22": "bash tools/node22-run.sh bun run test:browser:protocol-invariant",
    "test:browser:protocol:node22": "bash tools/node22-run.sh bun run test:browser:protocol",
    "test:modern-browser": "bun run check:runtime && playwright test --config=playwright.config.ts",
    "test:legacy-browser": "node tools/legacy-retired.cjs test:legacy-browser",
    "test:legacy-browser:node22": "node tools/legacy-retired.cjs test:legacy-browser:node22",
    "test:modern-browser:node22": "bash tools/node22-run.sh bun run test:modern-browser",
    "test:modern-browser:install": "playwright install chromium",
    "verify": "bun run verify:modern",
    "verify:modern": "bun run check:runtime && bun run check:server-shadow-hardening && bun run check:cts-require-const && bun run check:protocol-contract-sync && bun run check:protocol-contract-esm-parity && bun run check:package-mode-boundaries && bun run check:modern-jquery-free && bun run check:runtime-esm-require-free && bun run check:client-runtime-coverage && bun run check:client-runtime-alias-drift:strict && bun run check:server-esm-runtime-coverage && bun run check:ws-runtime-factory-sync && bun run check:worldserver-sync && bun run check:player-sync && bun run check:character-sync && bun run check:mob-sync && bun run check:mobarea-sync && bun run check:map-sync && bun run check:chest-sync && bun run check:properties-sync && bun run check:entity-sync && bun run check:item-sync && bun run check:npc-sync && bun run check:message-sync && bun run check:chestarea-sync && bun run check:checkpoint-sync && bun run check:area-sync && bun run check:formulas-sync && bun run check:log-sync && bun run check:utils-sync && bun run check:format-sync && bun run check:metrics-client-sync && bun run check:config-preflight-sync && bun run check:main-sync && bun run check:main-runtime-sync && bun run check:ws-module-sync && bun run check:metrics-sync && bun run check:metrics-runtime-sync && bun run typecheck:server-esm && bun run lint && bun run format:check && bun run test && bun run build:vite",
    "verify:modern:node22": "bash tools/node22-run.sh bun run verify:modern",
    "verify:legacy": "node tools/legacy-retired.cjs verify:legacy",
    "verify:legacy:node22": "node tools/legacy-retired.cjs verify:legacy:node22",
    "test": "bun test --timeout 20000",
    "lint": "eslint \"server/js/**/*.js\" \"client/js-esm/**/*.js\" \"shared/js/**/*.js\" \"tests/**/*.ts\"",
    "format": "prettier --write \"server/js/{log,utils,format}.cts\" \"client/js-esm/compat/*.js\" \"client/js-esm/preflight.js\" \"shared/js/gametypes.js\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"server/js/{log,utils,format}.cts\" \"client/js-esm/compat/*.js\" \"client/js-esm/preflight.js\" \"shared/js/gametypes.js\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "jquery": "4",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "25.2.2",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "bun-types": "^1.3.8",
    "eslint": "10.0.0",
    "globals": "^17.3.0",
    "prettier": "^3.8.1",
    "requirejs-esm-converter": "^2.1.0",
    "typescript": "5.9.3",
    "vite": "^7.3.1"
  }
}
