{
  "name": "browserquest",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun run dev:vite:full",
    "dev:client": "vite",
    "dev:server": "bun run start:server",
    "dev:vite:full": "bun run tools/dev-vite.ts",
    "start:server": "bun server/js/main-esm.ts",
    "content:mobs:generate": "bun tools/content-mob-properties.ts generate",
    "check:content:mobs": "bun tools/content-mob-properties.ts check",
    "content:item-loot:generate": "bun tools/content-item-loot-messages.ts generate",
    "check:content:item-loot": "bun tools/content-item-loot-messages.ts check",
    "build:vite": "vite build",
    "build:server": "bun tools/build-server.ts",
    "build:bundle": "bun run build:vite && bun run build:server && bun tools/build-bundle.ts",
    "check:runtime": "bun tools/check-runtime.ts",
    "check:server-shadow-hardening": "bun tools/check-server-shadow-source-hardening.ts",
    "check:deps:drift": "bun tools/check-dependency-drift.ts",
    "check:browser:workflow-drift": "bun tools/check-browser-workflow-drift.ts",
    "typecheck": "bun x tsc -b tsconfig.json",
    "typecheck:client": "bun x tsc -p tsconfig.browser.json",
    "typecheck:server-esm": "bun x tsc -p tsconfig.node.json",
    "check:package-mode-boundaries": "bun tools/check-package-mode-boundaries.ts",
    "check:runtime-esm-require-free": "bun tools/check-runtime-esm-require-free.ts",
    "check:metrics:healthy-prereqs": "bun tools/check-metrics-healthy-prereqs.ts",
    "test:modern-parity": "bun test tests/smoke/modern-gameplay-parity.test.ts --timeout 30000",
    "test:server:probes": "bun test tests/smoke/server-health-version.test.ts --timeout 30000",
    "test:server:shutdown": "bun test tests/smoke/server-shutdown-signals.test.ts --timeout 30000",
    "test:metrics:healthy": "bun run check:metrics:healthy-prereqs && BQ_TEST_METRICS_HEALTH=1 bun test --timeout 30000 tests/smoke/server-metrics-healthy.optional.test.ts",
    "test:ws:runtime:parity": "bun test tests/unit/ws-runtime-parity.test.ts tests/unit/ws-runtime-class-factory.test.ts tests/unit/server-ws-esm.test.ts",
    "test:ws:runtime:decision": "bun test tests/unit/ws-runtime-boundary-decision.test.ts tests/unit/ws-runtime-parity.test.ts",
    "test:ws:runtime:drill": "bun tools/run-ws-boundary-drill.ts",
    "test:browser:modern": "bun run check:runtime && playwright test --config=playwright.config.ts",
    "test:browser:protocol-invariant": "bun run check:runtime && playwright test --config=playwright.config.ts tests/browser/protocol-invariant.playwright.ts",
    "test:browser:protocol": "bun run check:runtime && playwright test --config=playwright.config.ts tests/browser/modern-protocol-actions.playwright.ts tests/browser/protocol-invariant.playwright.ts",
    "test:browser:protocol:ci": "bun run check:runtime && PLAYWRIGHT_JUNIT_OUTPUT_NAME=protocol-invariant-junit.xml playwright test --config=playwright.config.ts tests/browser/modern-protocol-actions.playwright.ts tests/browser/protocol-invariant.playwright.ts --reporter=line,junit",
    "verify": "bun run verify:modern",
    "verify:modern": "bun run check:runtime && bun run check:server-shadow-hardening && bun run check:package-mode-boundaries && bun run check:runtime-esm-require-free && bun run check:content:mobs && bun run check:content:item-loot && bun run typecheck && bun run lint && bun run format:check && bun run test && bun run build:vite",
    "verify:modern:node22": "bun tools/node22-run.ts bun run verify:modern",
    "test": "bun test --timeout 20000",
    "lint": "eslint \"client/js-esm/achievement-domain.ts\" \"client/js-esm/asset-key-domain.ts\" \"client/js-esm/client-boundary-types.ts\" \"shared/js/connection-status.ts\" \"shared/js/entity-kind-domain.ts\" \"shared/js/evented.ts\" \"shared/js/gametypes-browser.ts\" \"shared/js/protocol-contract-types.ts\" \"shared/js/protocol-contract.ts\" \"shared/js/protocol-schema.ts\" \"shared/js/typed-event-emitter.ts\" \"shared/js/ws-close-codes.ts\" \"server/js/character.ts\" \"server/js/item.ts\" \"server/js/message.ts\" \"server/js/mob.ts\" \"server/js/player-session-dispatch.ts\" \"server/js/player-session.ts\" \"server/js/player.ts\" \"server/js/properties.ts\" \"server/js/runtime-health-response.ts\" \"server/js/server-event-names.ts\" \"server/js/ws-runtime-class-factory-types.ts\" \"server/js/ws-runtime-class-factory.ts\" \"server/js/ws-runtime-esm.ts\"",
    "format": "prettier --write \"server/js/{log.ts,utils.ts,format.ts}\" \"client/js-esm/compat/*.ts\" \"client/js-esm/preflight.ts\" \"shared/js/gametypes-browser.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"server/js/{log.ts,utils.ts,format.ts}\" \"client/js-esm/compat/*.ts\" \"client/js-esm/preflight.ts\" \"shared/js/gametypes-browser.ts\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "memcache": "^1.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "25.2.2",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "bun-types": "^1.3.8",
    "eslint": "10.0.0",
    "globals": "^17.3.0",
    "prettier": "^3.8.1",
    "typescript": "5.9.3",
    "vite": "^7.3.1"
  }
}
