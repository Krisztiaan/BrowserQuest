{
  "name": "browserquest",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun run tools/dev.ts",
    "dev:client": "bun run tools/static-server.ts",
    "dev:server": "bun server/js/main.js",
    "dev:server:esm": "bun server/js/main-esm.mjs",
    "dev:vite": "vite",
    "dev:vite:full": "bun run tools/dev-vite.ts",
    "start:server": "bun server/js/main.js",
    "start:server:esm": "bun server/js/main-esm.mjs",
    "start:server:esm:ws-bridge:probe": "BQ_ESM_WS_BRIDGE_PROBE=1 bun server/js/main-esm.mjs",
    "start:server:esm:ws-runtime": "BQ_ESM_WS_RUNTIME=1 bun server/js/main-esm.mjs",
    "start:server:esm:ws-runtime:fail": "BQ_ESM_WS_RUNTIME=1 BQ_ESM_WS_RUNTIME_FORCE_FAIL=1 bun server/js/main-esm.mjs",
    "build:client": "bash bin/build.sh",
    "build:vite": "vite build",
    "build:vite:legacy": "BQ_VITE_INCLUDE_LEGACY=1 vite build",
    "check:runtime": "node tools/check-runtime.cjs",
    "check:deps:drift": "npm outdated --depth=0",
    "check:deps:drift:node22": "bash tools/node22-run.sh bun run check:deps:drift",
    "typecheck": "npx tsc -p tsconfig.typecheck.json && npx tsc -p tsconfig.typecheck-runtime.json",
    "typecheck:node22": "bash tools/node22-run.sh bun run typecheck",
    "check:class-fanout": "node tools/check-classjs-fanout.cjs",
    "check:ws:runbooks": "node tools/check-ws-boundary-runbook-consistency.cjs",
    "check:package-mode-boundaries": "node tools/check-package-mode-boundaries.cjs",
    "check:legacy-optimizer-integrity": "node tools/check-legacy-optimizer-integrity.cjs",
    "check:modern-jquery-free": "node tools/check-modern-jquery-free.cjs",
    "check:metrics:healthy-prereqs": "node tools/check-metrics-healthy-prereqs.cjs",
    "check:runtime:node22": "bash tools/node22-run.sh bun run check:runtime",
    "test:modern-parity": "bun test tests/smoke/modern-gameplay-parity.test.ts --timeout 30000",
    "test:static-entry": "bun test --timeout 20000 tests/smoke/static-server-entry-default.test.ts",
    "test:metrics:healthy": "bun run check:metrics:healthy-prereqs && BQ_TEST_METRICS_HEALTH=1 bun test --timeout 30000 tests/smoke/server-metrics-healthy.optional.test.ts",
    "test:smoke:esm:ws-runtime": "bun test --timeout 20000 tests/smoke/server-handshake-esm-ws-runtime.test.ts",
    "test:ws:runtime:parity": "bun test tests/unit/ws-runtime-parity.test.ts tests/unit/ws-runtime-class-factory.test.ts tests/unit/server-ws-esm.test.ts",
    "test:ws:runtime:decision": "bun test tests/unit/ws-runtime-boundary-decision.test.ts tests/unit/ws-runtime-parity.test.ts",
    "test:ws:runtime:drill": "node tools/run-ws-boundary-drill.cjs",
    "test:logs:lifecycle": "bun test --timeout 20000 tests/smoke/server-structured-logs.lifecycle.test.ts",
    "test:logs:fatal": "bun test --timeout 20000 tests/smoke/server-structured-logs.fatal.test.ts",
    "test:browser:modern": "bun run test:modern-browser",
    "test:browser:legacy": "bun run test:legacy-browser",
    "test:browser:legacy:hook-probe": "bun run check:runtime && BQ_TEST_LEGACY_HOOK=1 playwright test --config=playwright.config.ts tests/browser/legacy-hook-probe.playwright.ts",
    "test:browser:protocol-invariant": "bun run check:runtime && playwright test --config=playwright.config.ts tests/browser/protocol-invariant.playwright.ts",
    "test:browser:protocol": "bun run check:runtime && playwright test --config=playwright.config.ts tests/browser/modern-protocol-actions.playwright.ts tests/browser/protocol-invariant.playwright.ts",
    "test:browser:protocol:ci": "bun run check:runtime && PLAYWRIGHT_JUNIT_OUTPUT_NAME=protocol-invariant-junit.xml playwright test --config=playwright.config.ts tests/browser/modern-protocol-actions.playwright.ts tests/browser/protocol-invariant.playwright.ts --reporter=line,junit",
    "test:browser:modern:node22": "bun run test:modern-browser:node22",
    "test:browser:legacy:node22": "bun run test:legacy-browser:node22",
    "test:browser:legacy:hook-probe:node22": "bash tools/node22-run.sh bun run test:browser:legacy:hook-probe",
    "test:browser:protocol-invariant:node22": "bash tools/node22-run.sh bun run test:browser:protocol-invariant",
    "test:browser:protocol:node22": "bash tools/node22-run.sh bun run test:browser:protocol",
    "test:modern-browser": "bun run check:runtime && playwright test --config=playwright.config.ts",
    "test:legacy-browser": "bun run check:runtime && playwright test --config=playwright.config.ts tests/browser/legacy-ui-smoke.playwright.ts",
    "test:legacy-browser:node22": "bash tools/node22-run.sh bun run test:legacy-browser",
    "test:modern-browser:node22": "bash tools/node22-run.sh bun run test:modern-browser",
    "test:modern-browser:install": "playwright install chromium",
    "verify:modern": "bun run check:runtime && bun run check:package-mode-boundaries && bun run check:modern-jquery-free && bun run lint && bun run format:check && bun run test && bun run build:vite",
    "verify:modern:node22": "bash tools/node22-run.sh bun run verify:modern",
    "verify:legacy": "bun run check:runtime && bun run check:package-mode-boundaries && bun run check:legacy-optimizer-integrity && bun run test && bun run build:client && bun run build:vite:legacy",
    "verify:legacy:node22": "bash tools/node22-run.sh bun run verify:legacy",
    "test": "bun test --timeout 20000",
    "lint": "eslint \"server/js/**/*.js\" \"client/js-esm/**/*.js\" \"shared/js/**/*.js\" \"tests/**/*.ts\"",
    "format": "prettier --write \"server/js/{log,utils,format}.js\" \"client/js-esm/compat/*.js\" \"client/js-esm/preflight.js\" \"shared/js/gametypes.js\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"server/js/{log,utils,format}.js\" \"client/js-esm/compat/*.js\" \"client/js-esm/preflight.js\" \"shared/js/gametypes.js\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "jquery": "4",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.2.1",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "bun-types": "^1.3.8",
    "eslint": "10.0.0",
    "globals": "^17.3.0",
    "prettier": "^3.8.1",
    "requirejs-esm-converter": "^2.1.0",
    "vite": "^7.3.1"
  }
}
