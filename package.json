{
  "name": "browserquest",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun run dev:vite:full",
    "dev:client": "vite",
    "dev:server": "bun run start:server",
    "dev:vite": "vite",
    "dev:vite:full": "bun run tools/dev-vite.ts",
    "start:server": "bun server/js/main-esm.ts",
    "start:server:esm:ws-bridge:probe": "BQ_ESM_WS_BRIDGE_PROBE=1 bun server/js/main-esm.ts",
    "map:export": "bun tools/maps/export.ts both",
    "map:export:client": "bun tools/maps/export.ts client",
    "map:export:server": "bun tools/maps/export.ts server",
    "map:wang:sync": "bun tools/maps/wangset.ts",
    "check:map-wang-sync": "bun tools/maps/wangset.ts --check",
    "build:vite": "vite build",
    "check:runtime": "bun tools/check-runtime.ts",
    "check:server-shadow-hardening": "bun tools/check-server-shadow-source-hardening.ts",
    "check:cts-require-const": "bun tools/check-cts-require-const.ts",
    "check:deps:drift": "bun tools/check-dependency-drift.ts",
    "check:deps:drift:node22": "bash tools/node22-run.sh bun run check:deps:drift",
    "typecheck": "bun x tsc -b tsconfig.projects.json",
    "typecheck:client": "bun x tsc -p tsconfig.typecheck-client.json",
    "typecheck:client-runtime": "bun x tsc -p tsconfig.typecheck-client-runtime.json",
    "typecheck:server-esm": "bun x tsc -p tsconfig.typecheck-server-esm.json",
    "typecheck:node22": "bash tools/node22-run.sh bun run typecheck",
    "check:class-fanout": "bun tools/check-classjs-fanout.ts",
    "check:client-runtime-alias-drift": "bun tools/check-client-runtime-alias-drift.ts",
    "check:client-runtime-alias-drift:strict": "bun tools/check-client-runtime-alias-drift.ts --strict",
    "check:client-runtime-coverage": "bun tools/check-client-runtime-coverage.ts",
    "check:server-esm-runtime-coverage": "bun tools/check-server-esm-runtime-coverage.ts",
    "check:protocol-contract-esm-parity": "bun tools/check-protocol-contract-esm-parity.ts",
    "check:ws:runbooks": "bun tools/check-ws-boundary-runbook-consistency.ts",
    "check:package-mode-boundaries": "bun tools/check-package-mode-boundaries.ts",
    "check:runtime-esm-require-free": "bun tools/check-runtime-esm-require-free.ts",
    "check:metrics:healthy-prereqs": "bun tools/check-metrics-healthy-prereqs.ts",
    "check:runtime:node22": "bash tools/node22-run.sh bun run check:runtime",
    "test:modern-parity": "bun test tests/smoke/modern-gameplay-parity.test.ts --timeout 30000",
    "test:metrics:healthy": "bun run check:metrics:healthy-prereqs && BQ_TEST_METRICS_HEALTH=1 bun test --timeout 30000 tests/smoke/server-metrics-healthy.optional.test.ts",
    "test:smoke:esm:ws-runtime": "bun test --timeout 20000 tests/smoke/server-handshake-esm-ws-runtime.test.ts",
    "test:ws:runtime:parity": "bun test tests/unit/ws-runtime-parity.test.ts tests/unit/ws-runtime-class-factory.test.ts tests/unit/server-ws-esm.test.ts",
    "test:ws:runtime:decision": "bun test tests/unit/ws-runtime-boundary-decision.test.ts tests/unit/ws-runtime-parity.test.ts",
    "test:ws:runtime:drill": "bun tools/run-ws-boundary-drill.ts",
    "test:logs:lifecycle": "bun test --timeout 20000 tests/smoke/server-structured-logs.lifecycle.test.ts",
    "test:logs:fatal": "bun test --timeout 20000 tests/smoke/server-structured-logs.fatal.test.ts",
    "test:browser:modern": "bun run test:modern-browser",
    "test:browser:protocol-invariant": "bun run check:runtime && playwright test --config=playwright.config.ts tests/browser/protocol-invariant.playwright.ts",
    "test:browser:protocol": "bun run check:runtime && playwright test --config=playwright.config.ts tests/browser/modern-protocol-actions.playwright.ts tests/browser/protocol-invariant.playwright.ts",
    "test:browser:protocol:ci": "bun run check:runtime && PLAYWRIGHT_JUNIT_OUTPUT_NAME=protocol-invariant-junit.xml playwright test --config=playwright.config.ts tests/browser/modern-protocol-actions.playwright.ts tests/browser/protocol-invariant.playwright.ts --reporter=line,junit",
    "test:browser:modern:node22": "bun run test:modern-browser:node22",
    "test:browser:protocol-invariant:node22": "bash tools/node22-run.sh bun run test:browser:protocol-invariant",
    "test:browser:protocol:node22": "bash tools/node22-run.sh bun run test:browser:protocol",
    "test:modern-browser": "bun run check:runtime && playwright test --config=playwright.config.ts",
    "test:modern-browser:node22": "bash tools/node22-run.sh bun run test:modern-browser",
    "test:modern-browser:install": "playwright install chromium",
    "verify": "bun run verify:modern",
    "verify:modern": "bun run map:export && bun run check:runtime && bun run check:server-shadow-hardening && bun run check:cts-require-const && bun run check:protocol-contract-esm-parity && bun run check:package-mode-boundaries && bun run check:map-wang-sync && bun run check:runtime-esm-require-free && bun run check:client-runtime-coverage && bun run check:client-runtime-alias-drift:strict && bun run check:server-esm-runtime-coverage && bun run typecheck && bun run lint && bun run format:check && bun run test && bun run build:vite",
    "verify:modern:node22": "bash tools/node22-run.sh bun run verify:modern",
    "test": "bun test --timeout 20000",
    "lint": "eslint \"tests/**/*.ts\" \"client/js-esm/**/*.ts\"",
    "format": "prettier --write \"server/js/{log,utils,format}.cts\" \"client/js-esm/compat/*.ts\" \"client/js-esm/preflight.ts\" \"shared/js/gametypes.cts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"server/js/{log,utils,format}.cts\" \"client/js-esm/compat/*.ts\" \"client/js-esm/preflight.ts\" \"shared/js/gametypes.cts\" \"tests/**/*.ts\""
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "25.2.2",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "bun-types": "^1.3.8",
    "eslint": "10.0.0",
    "globals": "^17.3.0",
    "prettier": "^3.8.1",
    "typescript": "5.9.3",
    "vite": "^7.3.1"
  }
}
