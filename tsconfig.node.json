{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2022"],
        "types": ["bun-types", "node"],

        /* Strict type-checking */
        "strict": true,
        "strictNullChecks": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true,
        "noFallthroughCasesInSwitch": true,
        "forceConsistentCasingInFileNames": true,

        /* Emit */
        "noEmit": true,
        "composite": true,
        "tsBuildInfoFile": ".tmp/tsbuildinfo/typecheck-node.tsbuildinfo",
        "skipLibCheck": true,

        /* Modules */
        "resolveJsonModule": true,
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true
    },
    "include": [
        "server/js/**/*.ts",
        "shared/js/**/*.ts",
        "client/js-esm/client-boundary-types.ts",
        "client/js-esm/achievement-domain.ts",
        "client/js-esm/asset-key-domain.ts"
    ],
    "exclude": [
        "server/js/worldserver.ts",
        "server/js/worldserver-*.ts",
        "server/js/main-runtime.ts",
        "server/js/main.ts",
        "server/js/main-esm.ts",
        "server/js/main-esm-*.ts"
    ]
}
